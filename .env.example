# Claude API key. Only needed for real /ask requests; generation, cleaning and tests work without it.
ANTHROPIC_API_KEY=
# Claude model used to turn questions into SQL.
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side fallback when the model declines a request: "default" to enable, empty to disable.
ANTHROPIC_FALLBACKS=default

# SQLite database built by `python -m scripts.clean_and_load`.
DATABASE_PATH=data/orders.db

# Limits
LLM_TIMEOUT_SECONDS=20
QUERY_TIMEOUT_SECONDS=5
MAX_QUERY_ROWS=100
